    <!-- Home -->
    <string name="home_pulse_title">आज की पल्स</string>
    <string name="home_pulse_desc">आपकी टाइपिंग दक्षता का रीयल-टाइम विश्लेषण। RPM (प्रति मिनट दर) आपकी वैचारिक गति मापता है—कितनी तेज़ी से आप विचारों को शब्दों में बदलते हैं। Keys/Sec लेआउट पर आपकी कच्ची शारीरिक कुशलता और उंगली की गति मापता है।</string>
    <string name="home_trends_title">उपयोग रुझान</string>
    <string name="home_trends_desc">समय के साथ आपकी कीबोर्ड गतिविधि को ट्रैक करता है। साप्ताहिक और मासिक दृश्य आपको अपने सबसे उत्पादक दिनों की पहचान करने और पूरे वर्ष अपनी \'डिजिटल सहनशक्ति\' की निगरानी करने में मदद करते हैं।</string>
    <string name="home_distribution_title">वार्षिक वितरण</string>
    <string name="home_distribution_desc">आपकी टाइपिंग मात्रा का मौसमी विश्लेषण। यह डोनट चार्ट दिखाता है कि आप किन महीनों में सबसे अधिक सक्रिय थे, जिससे आप अपनी टाइपिंग आदतों को काम या सामाजिक गतिविधि की अवधियों से जोड़ सकते हैं।</string>
    <string name="home_heatmap_title">शब्द हीटमैप</string>
    <string name="home_heatmap_desc">आपकी शब्दावली की भाषाई छाप। आपके शीर्ष शब्द एक लघु लेआउट पर मैप किए जाते हैं। कुंजी जितनी गहरी, आपके डिजिटल संचार में वह शब्द उतना ही केंद्रीय।</string>
    <string name="home_emojis_title">इमोजी लीडरबोर्ड</string>
    <string name="home_emojis_desc">हर इमोजी स्कोर 0 से शुरू होता है। हर बार उपयोग करने पर +1 स्कोर मिलता है, इसलिए जितना अधिक उपयोग करेंगे, रैंक उतनी ऊँची होगी। लीडरबोर्ड टैब आपके शीर्ष 10 सबसे अधिक उपयोग किए गए इमोजी दिखाता है।</string>
