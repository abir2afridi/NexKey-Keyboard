    <!-- Home -->
    <string name="home_pulse_title">آج کی نبض</string>
    <string name="home_pulse_desc">آپ کی ٹائپنگ کی کارکردگی کا حقیقی وقت تجزیہ۔ RPM (فی منٹ شرح) آپ کی تصوراتی رفتار کی پیمائش کرتا ہے — کتنی تیزی سے آپ خیالات کو الفاظ میں بدلتے ہیں۔ کلیدیں/سیکنڈ آپ کی جسمانی انگلی کی رفتار کی پیمائش کرتا ہے۔</string>
    <string name="home_trends_title">استعمال کے رجحانات</string>
    <string name="home_trends_desc">وقت کے ساتھ آپ کی کی بورڈ سرگرمی کو ٹریک کرتا ہے۔ ہفتہ وار اور ماہانہ مناظر آپ کو اپنے سب سے زیادہ نتیجہ خیز دنوں کی نشاندہی میں مدد دیتے ہیں۔</string>
    <string name="home_distribution_title">سالانہ تقسیم</string>
    <string name="home_distribution_desc">آپ کی ٹائپنگ مقدار کا موسمی تجزیہ۔ یہ ڈونٹ چارٹ دکھاتا ہے کہ آپ کن مہینوں میں سب سے زیادہ متحرک تھے۔</string>
    <string name="home_heatmap_title">لفظ ہیٹ میپ</string>
    <string name="home_heatmap_desc">آپ کے ذخیرہ الفاظ کا لسانی شناختی نشان۔ آپ کے اہم الفاظ ایک چھوٹے کی بورڈ پر نقش ہوتے ہیں۔ کلید جتنی گہری، لفظ اتنا ہی مرکزی۔</string>
    <string name="home_emojis_title">ایموجی لیڈر بورڈ</string>
    <string name="home_emojis_desc">آپ کے جذباتی اظہار کے نمونوں کو دکھاتا ہے۔ یہ درجہ بندی دکھاتی ہے کہ آپ کن ایموجیز پر سب سے زیادہ انحصار کرتے ہیں۔</string>
