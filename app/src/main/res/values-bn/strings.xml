    <string name="meter_rules_line1">১. আপনি টাইপ করার সময় মিটার আপনার লাইভ গতি (প্রতি সেকেন্ডে অক্ষর, CPS) দেখায়।</string>
    <string name="meter_rules_line2">২. আপনি নির্বাচিত উইন্ডোর জন্য থামলে, অটো-সোয়াইপ শেষ হয় এবং সেই উইন্ডোতে চাপানো শব্দ গোনা হয়।</string>
    <string name="meter_rules_line3">৩. যতবার আপনি কোনো উইন্ডোয় নিজের সেরা গতি ভাঙেন, ততবার তারিখ ও সময়, শব্দ সংখ্যা, গতি (CPS বা CPM) ও ধারা-সহ রেকর্ড সংরক্ষিত হয়।</string>
    <string name="meter_rules_line4">৪. তালিকায় কেবল রেকর্ড-ভাঙার ঘটনাগুলোই দেখানো হয়; আপনি যতক্ষণ নিজের রেকর্ড ভাঙবেন, ধারা তত বাড়বে।</string>
    <string name="home_speed_title">অটো-সোয়াইপ গতি</string>
    <string name="home_speed_desc">কীবোর্ড প্রতিটি টাইপিং ধাপ নিজে নিজে মাপে। আপনি নির্বাচিত উইন্ডোর জন্য বিরতি নিলে এটি থামে, চাপানো শব্দ গোনে, CPS বা CPM হিসাব করে, আর যতবার নিজের সেরাকে ভাঙবেন ততবার রেকর্ড সেভ করে। তালিকা ও গ্রাফে কেবল রেকর্ড-ভাঙার ঘটনাগুলো দেখায়, প্রতিটি ইন্টারভালে তারিখ ও সময় অনুযায়ী সাজানো।</string>
