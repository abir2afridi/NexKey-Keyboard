    <!-- Home -->
    <string name="home_pulse_title">আজকের পালস</string>
    <string name="home_pulse_desc">আপনার টাইপিং দক্ষতার রিয়েল-টাইম বিশ্লেষণ। RPM (প্রতি মিনিটে হার) আপনার ধারণাগত গতি পরিমাপ করে—কত দ্রুত আপনি চিন্তাকে শব্দে রূপান্তর করেন। Keys/Sec কীবোর্ডে আপনার কাঁচা শারীরিক দক্ষতা ও আঙুলের গতি পরিমাপ করে।</string>
    <string name="home_trends_title">ব্যবহারের প্রবণতা</string>
    <string name="home_trends_desc">সময়ের সাথে আপনার কীবোর্ড কার্যকলাপ ট্র্যাক করে। সাপ্তাহিক ও মাসিক ভিউ আপনাকে সবচেয়ে উৎপাদনশীল দিনগুলো চিহ্নিত করতে এবং সারা বছর \'ডিজিটাল স্ট্যামিনা\' পর্যবেক্ষণ করতে সহায়তা করে।</string>
    <string name="home_distribution_title">বার্ষিক বণ্টন</string>
    <string name="home_distribution_desc">আপনার টাইপিং ভলিউমের মৌসুমি বিশ্লেষণ। এই ডোনাট চার্ট দেখায় কোন মাসগুলোতে আপনি সবচেয়ে সক্রিয় ছিলেন, যা আপনার টাইপিং অভ্যাসকে কাজ বা সামাজিক কার্যকলাপের বিভিন্ন সময়ের সাথে সম্পর্কিত করতে সাহায্য করে।</string>
    <string name="home_heatmap_title">শব্দ হিটম্যাপ</string>
    <string name="home_heatmap_desc">আপনার শব্দভান্ডারের ভাষাগত ফিঙ্গারপ্রিন্ট। আপনার শীর্ষ শব্দগুলো একটি ক্ষুদ্র লেআউটে ম্যাপ করা হয়। কী যত গাঢ়, আপনার ডিজিটাল যোগাযোগে শব্দটি তত কেন্দ্রীয়।</string>
    <string name="home_emojis_title">ইমোজি লিডারবোর্ড</string>
    <string name="home_emojis_desc">আপনার আবেগ প্রকাশের ধরণগুলো প্রদর্শন করে। এই র্যাঙ্কিং দেখায় কোন ইমোজিগুলোর উপর আপনি সবচেয়ে বেশি নির্ভর করেন, যা আপনার ডিজিটাল ব্যক্তিত্ব সম্পর্কে মজার অন্তর্দৃষ্টি দেয়।</string>
